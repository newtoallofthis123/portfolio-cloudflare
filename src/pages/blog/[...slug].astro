---
import { getEntry } from "astro:content";
import Base from "../../layouts/base.astro";
import { Image } from "astro:assets";

const { slug } = Astro.params;

const post = await getEntry("blog", slug as string);

// @ts-ignore
const { Content } = await post?.render();

const meta = post?.data;
---

<Base
  title={meta?.title}
  emoji={meta?.emoji}
  color={meta?.color}
  description={meta?.description}
  img={`/og/${slug}.png`}
>
  {
    meta?.bg && (
      <div class={`fixed inset-0 -z-10 w-full h-full light:block ${meta.bgDark ? "" : "dark:hidden"}`} style={`background-color: ${meta.bg};`} />
    )
  }
  {
    meta?.bgDark && (
      <div class="fixed inset-0 -z-10 w-full h-full hidden dark:block" style={`background-color: ${meta.bgDark};`} />
    )
  }
  {
    meta?.fg && (
      <style is:global set:html={`body, body * { color: ${meta.fg} !important; } body nav a:hover { color: ${meta.bg} !important; }`} />
    )
  }
  <div class="md:px-2">
    <h1 class="md:text-4xl text-3xl font-black">
      {meta?.title}
    </h1>
    <p class="mt-2">
      {meta?.description}
    </p>
    <p class="mt-2 text-md dark:text-rosePine-subtle text-rosePineDawn-subtle">
      Posted on {meta?.date ? new Date(meta.date).toDateString() : null}
    </p>
    <div>
      {
        meta?.img && (
          <div class={`p-2 py-5`}>
            <Image class=" rounded-md" src={meta.img} alt={meta?.title} />
          </div>
        )
      }
    </div>
  </div>
  <div class="md:px-2 py-1">
    <Content />
  </div>
</Base>
